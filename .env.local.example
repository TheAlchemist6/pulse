# Pulse — Environment Variables
# Copy this file to .env.local and fill in the values

# =============================================================================
# AUTH (NextAuth.js)
# =============================================================================
# Canonical URL for OAuth callback and app base
NEXTAUTH_URL=http://localhost:3000

# Encrypt NextAuth session tokens — generate with:
# openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_here

# =============================================================================
# GOOGLE OAUTH
# =============================================================================
# Create at: https://console.cloud.google.com/apis/credentials
# 1. Create OAuth 2.0 Client ID (Web application)
# 2. Add authorized redirect URI: {NEXTAUTH_URL}/api/auth/callback/google
# 3. Enable YouTube Data API v3 in APIs & Services
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# =============================================================================
# DATABASE (Railway PostgreSQL)
# =============================================================================
# Get from Railway dashboard → your Postgres instance → Connection Details
# Format: postgresql://username:password@host:5432/databasename
DATABASE_URL=postgresql://user:pass@host:5432/pulse

# =============================================================================
# ANTHROPIC (Claude AI)
# =============================================================================
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxx

# =============================================================================
# TOKEN ENCRYPTION
# =============================================================================
# AES-256-GCM key for encrypting OAuth tokens stored in the database
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=your_32_byte_hex_key_here
